# === DATABASE ===
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastik?schema=public"

# === REDIS ===
REDIS_HOST="localhost"
REDIS_PORT=6379

# === JWT AUTH (Client/Courier Apps) ===
JWT_SECRET="change-me-in-production"
JWT_EXPIRATION="24h"

# === WEBHOOK API KEYS (Server-to-Server) ===
WEBHOOK_API_KEY="change-me-laurus-core-key"

# === BOOTSTRAP TOKEN (Provisionamento de Tenants — S2S, reutilizável) ===
BOOTSTRAP_TOKEN="generate-a-secure-random-token-here"

# === DELIVERY CONFIGURATION ===
# Clock drift tolerance in minutes (offline QR Code validation)
CLOCK_DRIFT_TOLERANCE_MINUTES=3

# Watchdog timeout in hours (deadlock detection)
WATCHDOG_TIMEOUT_HOURS=4

# Batching window in seconds (CEP grouping)
BATCHING_WINDOW_SECONDS=120

# === SERVER ===
PORT=3000
NODE_ENV="development"
